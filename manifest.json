{
  "manifest_version": 3,
  "name": "Dheeraj ",
  "description": "A description of your extension.",
  "version": "2.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icon1.jpg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        
        "script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["script.js"],
      "matches": ["<all_urls>"]
    }
  ]
}